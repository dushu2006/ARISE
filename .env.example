# The Python backend can load this file. No credentials are included; do not commit a populated .env.
# The native Tauri bridge does not parse .env; desktop token/data-path overrides must be inherited process variables.

# Product identity and local state location. Leave DATA_DIR unset to use the OS user data folder.
# ARISE__APP_NAME=ARISE
# ARISE__APP_VERSION=0.1.0
# ARISE__DATA_DIR=C:\Users\<user>\AppData\Local\ARISE

# Local HTTP/WebSocket control API. Defaults bind only to loopback.
# ARISE__API__HOST=127.0.0.1
# ARISE__API__PORT=8765
# ARISE__API__TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]
# ARISE__API__WEBSOCKET_HEARTBEAT_SECONDS=25
# ARISE__API__WEBSOCKET_CLIENT_QUEUE_SIZE=128
# Per connection; reconnect from the last received sequence after reaching the replay cap.
# ARISE__API__WEBSOCKET_REPLAY_LIMIT=5000
# ARISE__API__MAX_REQUEST_BYTES=1048576
# ARISE__API__REQUEST_BODY_TIMEOUT_SECONDS=30
# Leave AUTH_TOKEN unset to create a random token in the local user data directory.
# Configured API tokens must be 32..512 visible ASCII characters.
# ARISE__API__AUTH_TOKEN=<32-to-512-visible-ASCII-characters>

# SQLite path defaults to <DATA_DIR>/arise.sqlite3. Busy timeout is bounded (100..60000 ms).
# ARISE__DATABASE__PATH=C:\Users\<user>\AppData\Local\ARISE\arise.sqlite3
# ARISE__DATABASE__BUSY_TIMEOUT_MS=5000

# Bounded local orchestration and history limits.
# ARISE__RUNTIME__MAX_CONCURRENT_TASKS=2
# ARISE__RUNTIME__MAX_QUEUED_TASKS=64
# ARISE__RUNTIME__TASK_TIMEOUT_SECONDS=900
# ARISE__RUNTIME__RESOURCE_WAIT_TIMEOUT_SECONDS=15
# ARISE__RUNTIME__TASK_HISTORY_LIMIT=500
# Automatic settled-task purge is disabled by default. If enabled, only completed/cancelled/
# failed/blocked records older than this many days are removed; unknown/interrupted/partial
# tasks and their history remain for reconciliation. Request-ID tombstones remain after purge.
# ARISE__RUNTIME__TASK_HISTORY_RETENTION_DAYS=365

# No model provider is configured by default. For a local OpenAI-compatible endpoint,
# configure BASE_URL, MODEL_ID, and optionally PROVIDER_ID together.
# ARISE__MODEL__PROVIDER_ID=local-model
# ARISE__MODEL__BASE_URL=http://127.0.0.1:1234/v1
# ARISE__MODEL__MODEL_ID=<local-model-id>
# ARISE__MODEL__API_KEY_SECRET_NAME=LOCAL_MODEL_KEY
# Optional JSON fields are added to the OpenAI-compatible request body. For provider
# options, do not include credentials or routing fields (model/messages/stream/tokens).
# NVIDIA's composition defaults chat_template_kwargs.enable_thinking to false.
# ARISE__MODEL__PROVIDER_OPTIONS={"chat_template_kwargs":{"enable_thinking":false}}
# ARISE__MODEL__CONNECT_TIMEOUT_SECONDS=10
# ARISE__MODEL__REQUEST_TIMEOUT_SECONDS=120
# ARISE__MODEL__MAX_CONCURRENT_REQUESTS=4
# Cloud models require BOTH model and security opt-ins, plus HTTPS and an OS keyring secret.
# ARISE__MODEL__ALLOW_CLOUD=false

# Voice is disabled and does not access the microphone by default. To configure Gemini Live,
# install `.[voice]`, place the key in the OS keyring, and explicitly set both cloud opt-ins.
# Microphone use additionally requires `.[voice-local]`, a user-supplied Vosk model directory,
# explicit microphone_enabled=true, and a user click/API call to start listening. No audio is sent
# before local wake-word detection. Real Windows device/model/provider validation remains required.
# ARISE__VOICE__ENABLED=false
# ARISE__VOICE__MICROPHONE_ENABLED=false
# ARISE__VOICE__LOCAL_MODEL_PATH=C:\\Users\\<user>\\AppData\\Local\\ARISE\\models\\vosk-en
# ARISE__VOICE__MICROPHONE_DEVICE_ID=<optional-device-index>
# ARISE__VOICE__PLAYBACK_DEVICE_ID=<optional-device-index>
# ARISE__VOICE__WAKE_WORD=ARISE
# ARISE__VOICE__WAKE_WORD_MIN_CONFIDENCE=0.72
# ARISE__VOICE__MINIMUM_ASR_CONFIDENCE=0.65
# ARISE__VOICE__VAD_AGGRESSIVENESS=2
# ARISE__VOICE__LOCALE=en
# ARISE__VOICE__MODEL_ID=gemini-3.8-live
# ARISE__VOICE__API_KEY_SECRET_NAME=GEMINI_API_KEY
# ARISE__VOICE__ALLOW_CLOUD=false
# ARISE__VOICE__INACTIVITY_TIMEOUT_SECONDS=30
# ARISE__VOICE__CONNECT_TIMEOUT_SECONDS=15
# ARISE__VOICE__MAX_RECONNECT_ATTEMPTS=2
# ARISE__VOICE__RECONNECT_BACKOFF_SECONDS=0.5

# Windows UIA and perception are disabled by default. Coordinate fallback requires explicit opt-in,
# verified current/focus/DPI state, no human interference, and regions to avoid as physical desktop
# rectangles [x,y,width,height]. Do not enable unless the target desktop and hazards are reviewed.
# ARISE__DESKTOP__ENABLED=false
# ARISE__PERCEPTION__ENABLED=false
# ARISE__PERCEPTION__ALLOW_COORDINATE_FALLBACK=false
# ARISE__PERCEPTION__UNSAFE_REGIONS=[[0,0,120,80]]
# Browser automation additionally requires .[browser], installed Chromium, and allowed domains.
# ARISE__BROWSER__ENABLED=false
# ARISE__BROWSER__ALLOWED_DOMAINS=["example.com"]

# Persistent memory uses local SQLite and explicit one-time consent for every write.
# Nothing is inferred or stored automatically. Each record has a bounded expiry.
# ARISE__MEMORY__ENABLED=true
# ARISE__MEMORY__DEFAULT_RETENTION_DAYS=365
# ARISE__MEMORY__MAX_RETENTION_DAYS=3650
# Semantic vectors are optional. Point at a local OpenAI-compatible /embeddings endpoint only
# after validating that endpoint/model; lexical retrieval remains available without it.
# ARISE__EMBEDDINGS__ENABLED=false
# ARISE__EMBEDDINGS__BASE_URL=http://127.0.0.1:1234/v1
# ARISE__EMBEDDINGS__MODEL_ID=<local-embedding-model-id>
# ARISE__EMBEDDINGS__API_KEY_SECRET_NAME=LOCAL_EMBEDDINGS_KEY
# ARISE__MEMORY__ALLOW_CLOUD_EMBEDDINGS=false
# Cloud embeddings require all of: SECURITY__ALLOW_CLOUD_MODELS, EMBEDDINGS__ALLOW_CLOUD,
# MEMORY__ALLOW_CLOUD_EMBEDDINGS; the memory text is redacted before sending.

# Research is user-initiated and disabled by default. Both gates plus an OS-keyring entry are
# required. The query goes to Brave Search; selected public HTTPS sources are fetched safely.
# ARISE__RESEARCH__ENABLED=false
# ARISE__RESEARCH__API_KEY_SECRET_NAME=BRAVE_SEARCH_API_KEY
# ARISE__SECURITY__ALLOW_WEB_RESEARCH=false

# Safe defaults: API auth stays required, environment secrets and cloud routing stay disabled.
# Do not disable API auth in production.
# ARISE__SECURITY__ENVIRONMENT=development
# ARISE__SECURITY__REQUIRE_API_AUTH=true
# ARISE__SECURITY__ALLOW_ENVIRONMENT_SECRETS=false
# ARISE__SECURITY__ALLOW_CLOUD_MODELS=false
# ARISE__SECURITY__CONFIRMATION_TIMEOUT_SECONDS=90

# Logging accepts DEBUG, INFO, WARNING, ERROR, or CRITICAL. Logs never contain API credentials.
# ARISE__LOGGING__LEVEL=INFO
